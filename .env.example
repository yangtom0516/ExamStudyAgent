# Copy this file to .env and fill in the blanks. Never commit .env.
#
# Hostnames below are "localhost" for running the backend directly on your machine.
# Services running inside docker compose get the container hostnames (postgres, redis, ...)
# from docker-compose.yml instead.

# --- Gemini (Google AI Studio) ---
GOOGLE_API_KEY=
COACH_MODEL=
EXAM_MODEL=
GRADER_MODEL=
OCR_MODEL=
EMBED_MODEL=

# --- Postgres ---
# Any long random string, e.g. output of: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# Must use the same password as above.
DATABASE_URL=postgresql+asyncpg://study:PUT_POSTGRES_PASSWORD_HERE@localhost:5432/study

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
# Leave empty to derive it from EMBED_MODEL.
QDRANT_COLLECTION=

# --- File storage (SeaweedFS, S3 API) ---
S3_ENDPOINT=http://localhost:8333
# Any values you like; the storage container is configured with these same keys.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=examstudy

# --- Auth ---
# Long random string used to sign login tokens, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
