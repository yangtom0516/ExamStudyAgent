# Copy this file to .env and fill in the blanks. Never commit .env.
#
# Hostnames below are 127.0.0.1 for running the backend directly on your machine.
# Use 127.0.0.1, not "localhost": on Windows "localhost" tries IPv6 (::1) first, and since the
# containers listen on IPv4 only, every new connection waits ~2 s before falling back.
# Services running inside docker compose get the container hostnames (postgres, redis, ...)
# from docker-compose.yml instead.

# --- Gemini (Google AI Studio) ---
GOOGLE_API_KEY=
COACH_MODEL=
EXAM_MODEL=
GRADER_MODEL=
OCR_MODEL=
EMBED_MODEL=gemini-embedding-2
# Vector size: 768, 1536 or 3072. Changing the model or size means a new Qdrant collection (re-embed).
EMBED_DIMENSIONS=768

# --- Postgres ---
# Any long random string, e.g. output of: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
# Must use the same password as above.
DATABASE_URL=postgresql+asyncpg://study:PUT_POSTGRES_PASSWORD_HERE@127.0.0.1:5432/study

# --- Redis ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Qdrant ---
QDRANT_URL=http://127.0.0.1:6333
# Leave empty to derive it from EMBED_MODEL and EMBED_DIMENSIONS (chunks__gemini-embedding-2__768).
QDRANT_COLLECTION=

# --- File storage (SeaweedFS, S3 API) ---
S3_ENDPOINT=http://127.0.0.1:8333
# Any values you like; the storage container is configured with these same keys.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=examstudy
# Largest accepted upload, in MB.
MAX_UPLOAD_MB=50

# --- Auth ---
# Long random string used to sign login tokens, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# How long a login lasts (default 7 days).
JWT_EXPIRE_MINUTES=10080
# Set to true when the site is served over HTTPS (cloud deploy); false for http://localhost.
COOKIE_SECURE=false
